generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Program {
  btech_bca
  dsa
  aptitude
  gate
  web_dev
}

/// Moderation state for content that must be reviewed before students see it.
///
/// NOTE: the column default is `approved` on purpose. Every code path that
/// creates content sets this field explicitly, so the default only ever applies
/// to rows that already existed when this column was added — those must stay
/// visible instead of silently disappearing from the catalogue on deploy.
enum ApprovalStatus {
  pending
  approved
  rejected
}

model User {
  id                      String                   @id @default(uuid())
  name                    String                   @default("Student")
  email                   String?                  @unique
  avatar                  String?
  role                    Role                     @default(student)
  plan                    Plan                     @default(free)
  emailVerified           DateTime?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  password                String?
  phone                   String?                  @unique
  isDisabled              Boolean                  @default(false)
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  enrollments             Enrollment[]
  instructor              Instructor?
  progress                LessonProgress[]
  orders                  Order[]
  wishlist                Wishlist[]
  blogs                   Blog[]
  managedInstructors      Instructor[]             @relation("ManagedInstructors")
  submittedCourses        Course[]                 @relation("CourseSubmittedBy")
  reviewedCourses         Course[]                 @relation("CourseReviewedBy")
  submittedLiveClasses    LiveClass[]              @relation("LiveClassSubmittedBy")
  reviewedLiveClasses     LiveClass[]              @relation("LiveClassReviewedBy")
  reviewedBlogs           Blog[]                   @relation("BlogReviewedBy")
  uploadedMaterials       StudyMaterial[]
  notifications           Notification[]
}

model EmailVerificationToken {
  id        String   @id @default(uuid())
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Instructor {
  id             String      @id @default(uuid())
  userId         String?     @unique
  name           String
  title          String
  avatar         String?
  bio            String?
  qualifications String?
  experience     String?
  rating         Float       @default(0)
  students       Int         @default(0)
  courses        Course[]
  user           User?       @relation(fields: [userId], references: [id])
  liveClasses    LiveClass[]
  adminId        String?
  admin          User?       @relation("ManagedInstructors", fields: [adminId], references: [id])

  @@index([adminId])
}

model Course {
  id            String          @id @default(uuid())
  slug          String          @unique
  title         String
  category      String
  level         Level           @default(Beginner)
  price         Int
  originalPrice Int
  rating        Float           @default(0)
  ratingCount   Int             @default(0)
  durationHours Int             @default(0)
  lectures      Int             @default(0)
  language      String          @default("English")
  thumbnail     String?
  badge         String?
  tags          String[]
  createdAt     DateTime        @default(now())
  startsOn      DateTime?
  endsOn        DateTime?
  instructorId  String
  program       Program         @default(btech_bca)
  plannerUrl    String?
  popular       Boolean         @default(false)
  disabled      Boolean         @default(false)
  instructor    Instructor      @relation(fields: [instructorId], references: [id])
  enrollments   Enrollment[]
  lessons       Lesson[]
  liveClasses   LiveClass[]
  wishlist      Wishlist[]
  materials     StudyMaterial[]

  approvalStatus ApprovalStatus @default(approved)
  reviewNote     String?
  reviewedAt     DateTime?
  submittedById  String?
  submittedBy    User?          @relation("CourseSubmittedBy", fields: [submittedById], references: [id], onDelete: SetNull)
  reviewedById   String?
  reviewedBy     User?          @relation("CourseReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([category, level])
  @@index([program])
  @@index([approvalStatus])
}

model Lesson {
  id       String           @id @default(uuid())
  title    String
  order    Int
  courseId String
  course   Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  progress LessonProgress[]
}

model Enrollment {
  id           String   @id @default(uuid())
  progress     Int      @default(0)
  lastAccessed DateTime @default(now())
  userId       String
  courseId     String
  course       Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
}

model LessonProgress {
  id          String    @id @default(uuid())
  completed   Boolean   @default(false)
  completedAt DateTime?
  userId      String
  lessonId    String
  lesson      Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
}

model LiveClass {
  id           String     @id @default(uuid())
  title        String
  topic        String
  subject      String?
  meetingUrl   String?
  startsAt     DateTime
  endsAt       DateTime
  status       LiveStatus @default(Upcoming)
  instructorId String
  courseId     String?
  course       Course?    @relation(fields: [courseId], references: [id])
  instructor   Instructor @relation(fields: [instructorId], references: [id])

  createdAt      DateTime       @default(now())
  approvalStatus ApprovalStatus @default(approved)
  reviewNote     String?
  reviewedAt     DateTime?
  submittedById  String?
  submittedBy    User?          @relation("LiveClassSubmittedBy", fields: [submittedById], references: [id], onDelete: SetNull)
  reviewedById   String?
  reviewedBy     User?          @relation("LiveClassReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([approvalStatus])
  @@index([courseId, startsAt])
}

/// Course material a teacher shares with students who bought that course.
model StudyMaterial {
  id           String       @id @default(uuid())
  courseId     String
  course       Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title        String
  description  String?
  kind         MaterialKind @default(note)
  /// Data URL for uploaded files, or an external https link for `kind = link`.
  url          String
  fileName     String?
  fileSize     Int?
  mimeType     String?
  uploadedById String
  uploadedBy   User         @relation(fields: [uploadedById], references: [id], onDelete: Cascade)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([courseId, createdAt])
}

enum MaterialKind {
  note
  assignment
  slide
  reference
  link
}

model Wishlist {
  id       String @id @default(uuid())
  userId   String
  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
}

model Order {
  id                String      @id @default(uuid())
  amount            Int
  status            OrderStatus @default(Pending)
  course            String
  courseId          String?
  planName          String?
  razorpayOrderId   String?     @unique
  razorpayPaymentId String?
  createdAt         DateTime    @default(now())
  userId            String
  user              User        @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Otp {
  id        String   @id @default(uuid())
  phone     String
  code      String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([phone])
}

model Announcement {
  id    String   @id @default(uuid())
  title String
  body  String
  tone  String   @default("info")
  date  DateTime @default(now())
}

model Blog {
  id            String   @id @default(uuid())
  title         String
  slug          String   @unique
  content       String
  subject       String
  featuredImage String?
  tags          String[]
  published     Boolean  @default(false)
  authorId      String
  author        User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  /// Short teaser rendered on blog cards and used as the meta description.
  excerpt     String?
  /// Estimated reading time in minutes, derived from the content on save.
  readMinutes Int     @default(1)
  views       Int     @default(0)
  featured    Boolean @default(false)

  approvalStatus ApprovalStatus @default(approved)
  reviewNote     String?
  reviewedAt     DateTime?
  reviewedById   String?
  reviewedBy     User?          @relation("BlogReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([subject])
  @@index([published, createdAt])
  @@index([approvalStatus])
}

model SiteCounter {
  id        String   @id
  key       String   @unique
  value     Int      @default(0)
  updatedAt DateTime @updatedAt
}

enum Role {
  student
  instructor
  admin
  superadmin
}

enum Plan {
  free
  premium
}

enum Level {
  Beginner
  Intermediate
  Advanced
}

enum LiveStatus {
  Upcoming
  Live
  Ongoing
  Completed
}

enum OrderStatus {
  Success
  Failed
  Pending
}

/// An in-app notification addressed to exactly one user.
///
/// Events fan out on write (one row per recipient) rather than being computed
/// on read: the read path is then a single indexed query, and a notification
/// keeps the wording it had when it was sent even if the source row changes.
model Notification {
  id     String           @id @default(uuid())
  userId String
  user   User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type   NotificationType @default(system)

  title String
  body  String
  /// In-app destination for the whole row, e.g. "/dashboard/live-classes".
  href  String?

  readAt    DateTime?
  createdAt DateTime  @default(now())

  /// Stable per-event key ("live-class:<id>") so re-running an event — an
  /// approve/unapprove/approve cycle, a retried request — cannot duplicate a row.
  dedupeKey String

  @@unique([userId, dedupeKey])
  @@index([userId, createdAt])
  @@index([userId, readAt])
}

enum NotificationType {
  master_class
  live_class
  material
  blog
  approval
  decision
  order
  system
}
