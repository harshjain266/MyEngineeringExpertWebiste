generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                      String                   @id @default(uuid())
  name                    String                   @default("Student")
  email                   String?                  @unique
  avatar                  String?
  role                    Role                     @default(student)
  plan                    Plan                     @default(free)
  emailVerified           DateTime?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  password                String?
  phone                   String?                  @unique
  isDisabled              Boolean                  @default(false)
  emailVerificationTokens EmailVerificationToken[]
  enrollments             Enrollment[]
  instructor              Instructor?
  progress                LessonProgress[]
  orders                  Order[]
  wishlist                Wishlist[]
  blogs                   Blog[]
  managedInstructors      Instructor[]              @relation("ManagedInstructors")
}

model EmailVerificationToken {
  id        String   @id @default(uuid())
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Instructor {
  id             String      @id @default(uuid())
  userId         String?     @unique
  name           String
  title          String
  avatar         String?
  bio            String?
  qualifications String?
  experience     String?
  rating         Float       @default(0)
  students       Int         @default(0)
  courses        Course[]
  user           User?       @relation(fields: [userId], references: [id])
  liveClasses    LiveClass[]
  adminId        String?
  admin          User?       @relation("ManagedInstructors", fields: [adminId], references: [id])

  @@index([adminId])
}

model Course {
  id            String       @id @default(uuid())
  slug          String       @unique
  title         String
  category      String
  level         Level        @default(Beginner)
  price         Int
  originalPrice Int
  rating        Float        @default(0)
  ratingCount   Int          @default(0)
  durationHours Int          @default(0)
  lectures      Int          @default(0)
  language      String       @default("English")
  thumbnail     String?
  badge         String?
  tags          String[]
  createdAt     DateTime     @default(now())
  instructorId  String
  program       String       @default("btech-bca")
  plannerUrl    String?
  popular       Boolean      @default(false)
  disabled      Boolean      @default(false)
  instructor    Instructor   @relation(fields: [instructorId], references: [id])
  enrollments   Enrollment[]
  lessons       Lesson[]
  liveClasses   LiveClass[]
  wishlist      Wishlist[]

  @@index([category, level])
  @@index([program])
}

model Lesson {
  id       String           @id @default(uuid())
  title    String
  order    Int
  courseId String
  course   Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  progress LessonProgress[]
}

model Enrollment {
  id           String   @id @default(uuid())
  progress     Int      @default(0)
  lastAccessed DateTime @default(now())
  userId       String
  courseId     String
  course       Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
}

model LessonProgress {
  id          String    @id @default(uuid())
  completed   Boolean   @default(false)
  completedAt DateTime?
  userId      String
  lessonId    String
  lesson      Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
}

model LiveClass {
  id           String     @id @default(uuid())
  title        String
  topic        String
  subject      String?
  meetingUrl   String?
  startsAt     DateTime
  endsAt       DateTime
  status       LiveStatus @default(Upcoming)
  instructorId String
  courseId     String?
  course       Course?    @relation(fields: [courseId], references: [id])
  instructor   Instructor @relation(fields: [instructorId], references: [id])
}

model Wishlist {
  id       String @id @default(uuid())
  userId   String
  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
}

model Order {
  id                String      @id @default(uuid())
  amount            Int
  status            OrderStatus @default(Pending)
  course            String
  courseId          String?
  planName          String?
  razorpayOrderId   String?     @unique
  razorpayPaymentId String?
  createdAt         DateTime    @default(now())
  userId            String
  user              User        @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Otp {
  id        String   @id @default(uuid())
  phone     String
  code      String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([phone])
}

model Announcement {
  id    String   @id @default(uuid())
  title String
  body  String
  tone  String   @default("info")
  date  DateTime @default(now())
}

model Blog {
  id            String     @id @default(uuid())
  title         String
  slug          String     @unique
  content       String
  subject       String
  featuredImage String?
  tags          String[]
  published     Boolean    @default(false)
  authorId      String
  author        User       @relation(fields: [authorId], references: [id], onDelete: Cascade)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([subject])
  @@index([published, createdAt])
}

enum Role {
  student
  instructor
  admin
  superadmin
}

enum Plan {
  free
  premium
}

enum Level {
  Beginner
  Intermediate
  Advanced
}

enum LiveStatus {
  Upcoming
  Live
  Ongoing
  Completed
}

enum OrderStatus {
  Success
  Failed
  Pending
}
