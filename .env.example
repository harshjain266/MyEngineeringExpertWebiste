# ─────────────────────────────────────────────────────────────
# EngineeringExpert — environment
# Copy to `.env` and fill in. Safe defaults match docker-compose.
# ─────────────────────────────────────────────────────────────

# App
NEXT_PUBLIC_APP_NAME="EngineeringExpert"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Postgres (matches docker-compose.yml)
DATABASE_URL="postgresql://ee_user:ee_password@localhost:5432/engineering_expert?schema=public"

# Redis (sessions / caching / rate-limiting)
REDIS_URL="redis://localhost:6379"

# Auth (stubbed for now — wire NextAuth/Auth.js later)
AUTH_SECRET="dev-only-change-me"

# Payments (stubbed — wire Razorpay/Stripe later)
PAYMENTS_PROVIDER="razorpay"
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# Feature flags
USE_MOCK_DATA="true"
