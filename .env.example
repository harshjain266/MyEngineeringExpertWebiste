# ─────────────────────────────────────────────────────────────
# EngineeringExpert — environment
# Copy to `.env` and fill in. Safe defaults match docker-compose.
# ─────────────────────────────────────────────────────────────

# App
NEXT_PUBLIC_APP_NAME="EngineeringExpert"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Postgres (matches docker-compose.yml)
DATABASE_URL="postgresql://ee_user:ee_password@localhost:5432/engineering_expert?schema=public"

# Redis (sessions / caching / rate-limiting)
REDIS_URL="redis://localhost:6379"

# Auth (stubbed for now — wire NextAuth/Auth.js later)
AUTH_SECRET="dev-only-change-me"

# Payments (stubbed — wire Razorpay/Stripe later)
PAYMENTS_PROVIDER="razorpay"
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# Feature flags
USE_MOCK_DATA="true"

# ── Cloudinary (file storage) ──────────────────────────────────
# When set, uploads (syllabus PDFs, study material, images, avatars) go to
# Cloudinary and only the URL is stored in Postgres. Leave blank to fall back
# to inline data URLs in the database.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=engineering-expert
